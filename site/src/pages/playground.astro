---
import DocLayout from "../layouts/DocLayout.astro";
import Replay from "../components/Replay.astro";
const example = `from pathlib import Path
from tempfile import TemporaryDirectory
from axiom.durable import Request
from axiom.service import Service

with TemporaryDirectory() as directory:
    path = Path(directory) / "graph.db"
    with Service(path, n=8) as graph:
        assert graph.partner(0).result(5) == (1, 1)
        deleted = graph.submit(Request(1, "delete", 0, 1)).result(5)
        assert deleted.changed and deleted.version == 2
        assert graph.partner(0).result(5) == (2, None)
        assert graph.check().result(5)
        inserted = graph.submit(Request(2, "insert", 0, 1)).result(5)
        assert inserted.changed and inserted.version == 3
        assert graph.partner(0).result(5) == (3, 1)
        assert graph.check().result(5)
    with Service(path) as recovered:
        assert recovered.partner(0).result(5) == (3, 1)
        assert recovered.submit(Request(2, "insert", 0, 1)).result(5) == inserted
        try:
            recovered.submit(Request(2, "delete", 0, 1)).result(5)
        except ValueError:
            pass  # Same ID with a different payload must reject.
        else:
            raise AssertionError("incompatible retry accepted")
        assert [recovered.partner(v).result(5) for v in range(8)] == [
            (3, v ^ 1) for v in range(8)
        ]
        for u in range(8):
            for v in range(u + 1, 8):
                assert recovered.has_edge(u, v).result(5) == (
                    3, v - u in (1, 2, 6, 7)
                )
        assert recovered.check().result(5)`;
