---
import DocLayout from "../layouts/DocLayout.astro";
import Replay from "../components/Replay.astro";
const example = `from pathlib import Path
from tempfile import TemporaryDirectory
from axiom.durable import Request
from axiom.service import Service

with TemporaryDirectory() as directory:
    path = Path(directory) / "graph.db"
    with Service(path, n=8) as graph:
        initial_version, partner = graph.partner(0).result(5)
        assert partner is not None
        initial_edges = {
            (u, v): graph.has_edge(u, v).result(5)[1]
            for u in range(8)
            for v in range(u + 1, 8)
        }
        deleted = graph.submit(Request(1, "delete", 0, partner)).result(5)
        assert deleted.changed and deleted.version == initial_version + 1
        assert graph.partner(0).result(5)[0] == deleted.version
        assert graph.check().result(5)
        inserted = graph.submit(Request(2, "insert", 0, partner)).result(5)
        assert inserted.changed and inserted.version == deleted.version + 1
        expected_partners = [graph.partner(v).result(5) for v in range(8)]
        assert all(version == inserted.version for version, _ in expected_partners)
        assert graph.check().result(5)
    with Service(path) as recovered:
        assert [recovered.partner(v).result(5) for v in range(8)] == expected_partners
        assert recovered.submit(Request(2, "insert", 0, partner)).result(5) == inserted
        try:
            recovered.submit(Request(2, "delete", 0, partner)).result(5)
        except ValueError:
            pass  # Same ID with a different payload must reject.
        else:
            raise AssertionError("incompatible retry accepted")
        assert [recovered.partner(v).result(5) for v in range(8)] == expected_partners
        for u in range(8):
            for v in range(u + 1, 8):
                assert recovered.has_edge(u, v).result(5) == (
                    inserted.version,
                    initial_edges[(u, v)],
                )
        assert recovered.check().result(5)`;
