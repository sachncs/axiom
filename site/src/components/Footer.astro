---
import { FOOTER_LINKS, SITE } from "../lib/data";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="footer">
  <div class="shell">
    <div class="footer__main">
      <div class="footer__brand">
        <a class="brand" href={`${base}/`} aria-label="Axiom — home">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none">
              <path d="M6 24 15.9 6 26 24" stroke="url(#foot1)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M10.8 17.5h10.4" stroke="url(#foot2)" stroke-width="1.8" stroke-linecap="round" />
              <circle cx="15.9" cy="6" r="2.4" fill="var(--bg-2)" stroke="url(#foot2)" stroke-width="1.6" />
              <circle cx="6" cy="24" r="2.4" fill="var(--bg-2)" stroke="url(#foot2)" stroke-width="1.6" />
              <circle cx="26" cy="24" r="2.4" fill="var(--bg-2)" stroke="url(#foot2)" stroke-width="1.6" />
              <defs>
                <linearGradient id="foot1" x1="0" y1="0" x2="32" y2="32">
                  <stop stop-color="#6ea1ff" /><stop offset="1" stop-color="#a06bff" />
                </linearGradient>
                <linearGradient id="foot2" x1="10" y1="11" x2="22" y2="21">
                  <stop stop-color="#4fd7ff" /><stop offset="1" stop-color="#a06bff" />
                </linearGradient>
              </defs>
            </svg>
          </span>
          <span class="brand__name">axiom</span>
        </a>
        <p>Deterministic dynamic graph matching for Python.</p>
        <a class="footer__paper mono" href={SITE.paper} target="_blank" rel="noopener">
          Read the paper
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 11l6-6M6.5 5H11v4.5"/></svg>
        </a>
      </div>

      {
        FOOTER_LINKS.map((group) => (
          <nav class="footer__col" aria-label={group.group}>
            <h4>{group.group}</h4>
            <ul>
              {
                group.links.map((l) => (
          <li><a href={l.href.startsWith("http") ? l.href : `${base}/${l.href}`} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener" : undefined}>{l.label}</a></li>
                ))
              }
            </ul>
          </nav>
        ))
      }

    </div>

    <div class="footer__bottom">
      <span class="mono">© 2026 · Axiom</span>
      <span class="mono">MIT licensed · pure Python 3.10+</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, transparent, var(--surface));
    margin-top: clamp(48px, 6vw, 80px);
  }

  .footer__main {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 40px;
    padding-block: clamp(48px, 6vw, 76px) 40px;
  }

  .footer__brand p {
    margin: 16px 0;
    font-size: 14.5px;
    line-height: 1.66;
    color: var(--ink-dim);
    max-width: 300px;
  }

  .footer__paper {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    font-size: 13px;
    color: var(--cobalt);
    transition: color var(--t-fast) var(--ease-out);
  }
  .footer__paper:hover {
    color: var(--ink);
  }
  .footer__paper svg {
    width: 13px;
    height: 13px;
    transform: translateY(1px);
  }

  .footer__col h4 {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .footer__col a {
    font-size: 14.5px;
    color: var(--ink-dim);
    transition: color var(--t-fast) var(--ease-out);
  }
  .footer__col a:hover {
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
    padding-block: 22px 30px;
    border-top: 1px solid var(--line);
    font-size: 12.5px;
    color: var(--ink-faint);
  }
  @media (max-width: 920px) {
    .footer__main {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer__bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>
