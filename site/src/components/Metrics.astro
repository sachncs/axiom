---
import { METRICS } from "@/lib/data";
---

<section class="metrics shell" aria-label="Key metrics">
  <div class="metrics__grid" data-reveal>
    {
      METRICS.map((m) => (
        <div class="metric">
          <span class="metric__value">
            <span class="metric__inner">{m.value}</span>
          </span>
          <div class="metric__label">{m.label}</div>
          <div class="metric__note">{m.note}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .metrics {
    padding-block: 10px clamp(40px, 5vw, 64px);
  }
  .metrics__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--surface), transparent);
    overflow: hidden;
  }
  .metric {
    padding: clamp(22px, 3vw, 34px) clamp(18px, 2.4vw, 28px);
    border-right: 1px solid var(--line);
    display: grid;
    gap: 4px;
    align-content: start;
  }
  .metric:last-child {
    border-right: 0;
  }
  .metric__value {
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 700;
    letter-spacing: -0.025em;
    overflow: hidden;
  }
  .metric__inner {
    background: var(--brand-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .metric__label {
    font-size: 14.5px;
    color: var(--ink);
    font-weight: 600;
  }
  .metric__note {
    font-size: 12.5px;
    color: var(--ink-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 900px) {
    .metrics__grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .metric:nth-child(2) {
      border-right: 0;
    }
    .metric:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 520px) {
    .metrics__grid {
      grid-template-columns: 1fr;
    }
    .metric {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .metric:last-child {
      border-bottom: 0;
    }
  }
</style>