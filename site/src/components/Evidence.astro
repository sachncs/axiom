---
import sweep from "../../../benchmarks/results/independent/candidate-soak-sweep-million.json";
import pulse from "../../../benchmarks/results/independent/pulse-long-million.json";
import hub from "../../../benchmarks/results/independent/hub-steady-million.json";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const runs = [
  { name: "Full-ring churn", label: "30 minutes", report: sweep },
  { name: "Growth & drain", label: "10 minutes", report: pulse },
  { name: "65,536-degree hub", label: "3 minutes", report: hub },
];
---
<section class="section shell evidence" aria-labelledby="evidence-title">
  <div class="evidence__panel">
    <div class="evidence__intro">
      <span class="eyebrow">Measured, not imagined</span>
      <h2 id="evidence-title">Speed is only useful<br />if the state <span class="gradient-text">survives.</span></h2>
      <p>Real insertions and deletions. Durable acknowledgments. Concurrent partner queries. Exact recovery checked against the final topology and matching.</p>
      <a class="text-link" href={`${base}/production/`}>Inspect the workloads & raw evidence →</a>
      <div class="evidence__certificate mono"><span aria-hidden="true">✓</span> Recovery certificates passed in all three stages</div>
    </div>
    <div class="evidence__chart" aria-label="Measured durable update throughput">
      <div class="evidence__caption mono"><span>1M vertices / local service</span><span>real updates/s</span></div>
      {runs.map(({name, label, report}) => <div class="evidence__run">
        <div class="evidence__row"><span>{name}<small>{label}</small></span><strong>{Math.round(report.real_acknowledged_updates_per_second).toLocaleString("en-US")}</strong></div>
        <div class="evidence__track" aria-hidden="true"><span style={`width: ${report.real_acknowledged_updates_per_second / 12000 * 100}%`}></span><i></i></div>
      </div>)}
      <div class="evidence__axis mono"><span>0</span><span>10k target</span><span>12k</span></div>
      <p class="evidence__scope">M3 Pro · 18 GiB · macOS/APFS. Degree-four ring; hub average degree 4.131064. Growth/drain uses MallocLargeCache=0. Includes final acknowledgment drain; not a loss-free or universal guarantee. Degree-64 misses the target.</p>
    </div>
  </div>
</section>
<style>
  .evidence { padding-block: 38px 68px; }
  .evidence__panel { display:grid; grid-template-columns: 1fr 1fr; gap: 60px; padding: clamp(24px,4vw,48px); border: 1px solid var(--line-strong); border-radius: var(--r-xl); background: var(--bg-3); }
  .evidence h2 { font-size: clamp(30px,3.3vw,44px); line-height:1.1; letter-spacing:-.045em; margin:24px 0 18px; }
  .evidence__intro > p { color:var(--ink-dim); font-size:16px; margin-bottom:24px; }
  .evidence__certificate { margin-top:32px; padding-top:20px; border-top:1px solid var(--line); color:var(--ink-dim); font-size:11px; }
  .evidence__certificate span { color:var(--mint); }
  .evidence__caption { display:flex; justify-content:space-between; gap:12px; font-size:10px; color:var(--ink-faint); padding-bottom:22px; border-bottom:1px solid var(--line); }
  .evidence__run { margin-top:24px; }
  .evidence__row { display:flex; justify-content:space-between; align-items:center; gap:16px; font-size:14px; }
  .evidence__row small { display:block; color:var(--ink-faint); font-size:11px; }
  .evidence__row strong { font-size:25px; letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
  .evidence__track { position:relative; height:8px; background:var(--surface-3); border-radius:4px; margin-top:10px; }
  .evidence__track span { display:block; height:100%; border-radius:4px; background:var(--brand-grad); }
  .evidence__track i { position:absolute; left:83.3333%; top:-4px; height:16px; border-left:1px dashed var(--ink); }
  .evidence__axis { position:relative; display:flex; justify-content:space-between; margin-top:14px; color:var(--ink-faint); font-size:10px; }
  .evidence__axis span:nth-child(2) { position:absolute; left:83.3333%; transform:translateX(-50%); white-space:nowrap; }
  .evidence__scope { color:var(--ink-faint); font-size:11px; line-height:1.7; margin:22px 0 0; }
  @media(max-width:860px) { .evidence__panel { grid-template-columns:1fr; gap:32px; } }
</style>
