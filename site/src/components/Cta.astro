---
import { INSTALL } from "../lib/data";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="section--tight shell" id="install">
  <div class="cta" data-reveal>
    <div class="cta__inner">
      <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Ready for the stream</span>
      <h2>
        Build on a graph that
        <br />
        <span class="serif gradient-text">keeps moving.</span>
      </h2>
      <p>
        One import, zero runtime dependencies, and a matching you can inspect after
        every update. Start with the guide, then take the same stream into the playground.
      </p>

      <div class="cta__cmd mono" data-copy={INSTALL.pip}>
        <span class="cta__ps" aria-hidden="true">$</span>
        <code>{INSTALL.pip}</code>
      </div>

      <div class="cta__actions">
        <a class="btn btn--primary" href={`${base}/get-started/`}>
          Read the getting-started guide
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a class="btn btn--ghost" href={`${base}/playground/`}>
          Open the playground
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: clamp(56px, 8vw, 108px) 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .cta__inner {
    position: relative;
    display: grid;
    gap: 18px;
    justify-items: center;
    max-width: 720px;
  }
  .cta h2 {
    margin: 0;
    font-size: clamp(34px, 5.2vw, 58px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    font-weight: 690;
  }
  .cta p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 17px;
    line-height: 1.62;
    max-width: 560px;
  }

  .cta__cmd {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 520px;
    padding: 16px 22px;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    box-shadow: var(--ring);
    text-align: left;
    overflow-x: auto;
    white-space: nowrap;
  }
  .cta__ps {
    color: var(--mint);
    font-weight: 700;
  }
  .cta__cmd code {
    font-size: 14px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 10px;
  }
</style>
