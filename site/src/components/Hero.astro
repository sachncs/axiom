---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero shell" id="top" data-reveal>
  <div class="hero__glow grid-glow" aria-hidden="true"></div>

  <div class="hero__content">
    <span class="eyebrow"><span class="dot" aria-hidden="true"></span>Axiom Graph&nbsp;·&nbsp;dynamic matching</span>
    <h1 class="hero__title">
      The graph moves.
      <br />
      The answer <span class="serif gradient-text">stays.</span>
    </h1>
    <p class="hero__sub">Deterministic dynamic maximal matching for Python. Keep the answer current as your graph changes.</p>
    <p class="hero__provenance">A small, inspectable engine for engineers and researchers — informed by current dynamic-matching research.</p>

    <p class="hero__status"><span class="dot" aria-hidden="true"></span><strong>Current build:</strong> basic is the recommended starting point · multilevel is under research validation</p>

    <div class="hero__cta">
      <a class="btn btn--primary" href={`${base}/get-started/`}>
        Start building
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" />
        </svg>
      </a>
      <a class="btn btn--ghost" href={`${base}/playground/`}>
        Open the playground
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.5 3.3a1 1 0 0 1 1.52-.85l5.4 4.7a1.12 1.12 0 0 1 0 1.7l-5.4 4.7a1 1 0 0 1-1.52-.85V3.3Z"/></svg>
      </a>
    </div>

    <p class="hero__trust mono">
      struct axiom · pure python · zero deps &middot; mypy&nbsp;strict
    </p>
  </div>

  <div class="demo card" data-demo data-demo-home data-reveal style="--reveal-delay: 140ms">
    <div class="demo__topbar">
      <div class="demo__live">
        <span class="demo__live-dot"></span>
        <span class="mono">watch Axiom work</span>
      </div>
      <span class="demo__mode mono">basic</span>
      <div class="demo__controls" role="group" aria-label="Demo controls">
        <button type="button" data-demo-play aria-pressed="false">
          <span>Play update sequence</span>
        </button>
        <button type="button" data-demo-reset aria-label="Reset">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7V4m0 0h3M4 4l2.5 2.5A5 5 0 1 1 5 10" />
          </svg>
        </button>
      </div>
    </div>

    <div class="demo__canvas-wrap">
      <canvas data-demo-canvas tabindex="0" aria-label="Interactive graph visualization. Use arrow keys to select a node and Enter to toggle an edge."></canvas>
      <span class="sr-only" data-demo-status aria-live="polite"></span>
      <div class="demo__hint" data-demo-home-hint>
        <span class="dot" aria-hidden="true"></span>
        add or remove edges · arrows + Enter also work
      </div>
    </div>

    <div class="demo__stats mono" aria-label="Live engine status">
      <span><i data-out-max>✓ Maximal</i></span>
      <span>matching <b data-out-m>—</b></span>
      <span>updates <b data-out-tick>0</b></span>
      <span class="demo__details">edges <b data-out-e>—</b></span>
    </div>
    <div class="demo__legend">
      <span><strong>Maximal</strong> every live edge remains covered</span>
      <span class="demo__notation">notation: |E| edges · |M*| matching</span>
    </div>
    <div class="demo__event mono" data-demo-event>Ready to play · six deterministic updates</div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(54px, 7vw, 96px);
    padding-bottom: clamp(54px, 7vw, 96px);
    display: grid;
    grid-template-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    gap: clamp(36px, 6vw, 88px);
    align-items: center;
  }

  .hero__content {
    display: grid;
    justify-items: start;
    text-align: left;
    gap: 20px;
    max-width: 560px;
  }

  .hero__title {
    margin: 0;
    font-size: clamp(42px, 5.4vw, 72px);
    line-height: 0.98;
    letter-spacing: -0.034em;
    font-weight: 680;
  }
  .hero__title em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .hero__sub {
    margin: 0;
    font-size: clamp(16px, 1.55vw, 18px);
    line-height: 1.58;
    color: var(--ink-dim);
    max-width: 640px;
  }
  .hero__provenance {
    margin: -8px 0 0;
    max-width: 540px;
    color: var(--ink-faint);
    font-size: 13.5px;
    line-height: 1.55;
  }
  .hero__mono {
    color: var(--ink);
    font-size: 0.86em;
    white-space: nowrap;
  }
  .hero__mono sup {
    font-size: 0.7em;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 12px;
    margin-top: 6px;
  }

  .hero__trust {
    margin: 8px 0 0;
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ink-faint);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: -8px 0 0;
    color: var(--ink-faint);
    font-size: 13px;
  }
  .hero__status strong { color: var(--ink-dim); font-weight: 600; }
  .hero__status .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--mint); }

  /* ---------------- demo ---------------- */

  .demo {
    width: 100%;
    max-width: none;
    margin-top: 0;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: var(--glass);
    box-shadow: none;
  }

  .demo__topbar {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
  }

  .demo__live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--cobalt);
    text-transform: uppercase;
    font-weight: 600;
  }
  .demo__live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cobalt);
    animation: none;
  }

  .demo__modes {
    display: inline-flex;
    gap: 3px;
    padding: 3px;
    border-radius: 11px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .demo__modes button {
    padding: 6px 15px;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    color: var(--ink-dim);
    transition: color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out);
  }
  .demo__modes button.is-on {
    color: var(--ink);
    background: var(--surface-3);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .demo__mode { justify-self: end; color: var(--ink-faint); font-size: 12px; }

  .demo__controls {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
  }
  .demo__controls button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    font-size: 12.5px;
    font-weight: 600;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-dim);
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out);
  }
  .demo__controls button:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .demo__controls svg {
    width: 14px;
    height: 14px;
  }

  .demo__canvas-wrap {
    position: relative;
  }
  .demo__canvas-wrap canvas {
    width: 100%;
    height: clamp(300px, 40vw, 420px);
    display: block;
    touch-action: manipulation;
  }

  .demo__hint {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    border: 1px solid var(--line);
    font-size: 11.5px;
    letter-spacing: 0.01em;
    color: var(--ink-faint);
    white-space: nowrap;
    pointer-events: none;
  }
  .demo[data-demo-home] .demo__hint {
    display: none;
  }
  .demo__hint .dot {
    width: 5px;
    height: 5px;
    background: var(--cobalt);
    animation: none;
  }

  .demo__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
    padding: 12px 18px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--ink-faint);
    background: var(--surface);
  }
  .demo__stats i {
    font-style: normal;
    color: var(--mint);
    font-weight: 650;
  }
  .demo__stats b {
    color: var(--ink-dim);
    font-weight: 600;
  }
  .demo__tick {
    margin-left: auto;
  }
  .demo__details, .demo__notation { color: var(--ink-faint); }
  .demo__event { padding: 10px 16px 14px; color: var(--ink-faint); font-size: 11px; border-top: 1px solid var(--line); }

  .demo__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 10px 16px 13px;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-size: 11px;
    line-height: 1.45;
  }
  .demo__legend strong {
    color: var(--ink-dim);
    font-weight: 650;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .hero__content {
      justify-items: center;
      text-align: center;
      max-width: 760px;
      margin-inline: auto;
    }
    .hero__cta {
      justify-content: center;
    }
    .demo {
      max-width: 760px;
      margin-inline: auto;
    }
  }

  @media (max-width: 620px) {
    .demo__topbar { grid-template-columns: 1fr; gap: 8px; }
    .demo__mode { justify-self: start; }
    .demo__live { grid-row: 2; }
    .demo__controls { grid-row: 3; justify-content: flex-start; }
    .demo__stats {
      gap: 4px 14px;
    }
    .demo__hint {
      display: none;
    }
  }
</style>

<script>
  import { initDemo } from "../scripts/demo";
  document.addEventListener("astro:page-load", () => {
    const host = document.querySelector<HTMLElement>("[data-demo]");
    if (host) initDemo(host);
  });
  if (document.readyState !== "loading") {
    const root = document.querySelector<HTMLElement>("[data-demo]");
    if (root) initDemo(root);
  }
</script>
